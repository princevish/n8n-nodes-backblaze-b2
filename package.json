{
  "name": "n8n-nodes-backblaze-b2",
  "version": "1.0.1",
  "description": "Backblaze B2 integration for n8n",
  "license": "MIT",
  "author": {
    "name": "Prince Vishwakarma",
    "email": "princevworld@gmail.com",
    "url": "https://github.com/princevish"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "n8n-nodes",
    "backblaze",
    "backblaze b2",
    "cloud storage",
    "automation"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); const p = 'dist/src/BackblazeB2'; if (!fs.existsSync(p)) fs.mkdirSync(p, { recursive: true }); fs.copyFileSync('src/BackblazeB2/backblazeB2.svg', p + '/backblazeB2.svg');\"",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "test": "jest",
    "release": "n8n-node release"
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.10.0",
    "@n8n/node-cli": "^0.23.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/src/BackblazeB2/BackblazeB2.node.js"
    ],
    "credentials": [
      "dist/src/credentials/BackblazeB2Api.credentials.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/princevish/n8n-nodes-backblaze-b2.git"
  },
  "bugs": {
    "url": "https://github.com/princevish/n8n-nodes-backblaze-b2/issues"
  },
  "homepage": "https://github.com/princevish/n8n-nodes-backblaze-b2#readme"
}
